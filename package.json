{
  "name": "wechat-article-exporter",
  "version": "2.3.17",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "debug": "nuxt dev --inspect",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "NITRO_PRESET=cloudflare_pages nuxt build && npx wrangler --cwd dist pages dev",
    "format": "biome check --write",
    "postinstall": "nuxt prepare",
    "docker:build": "docker build --build-arg VERSION=$npm_package_version -t ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version .",
    "docker:publish": "docker push ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "dev:electron": "concurrently \"cross-env ELECTRON=true nuxt dev\" \"wait-on http://localhost:3000 && yarn electron:compile && electron .\"",
    "electron:dev": "yarn dev:electron",
    "build:electron": "cross-env ELECTRON=true nuxt generate && yarn electron:compile && electron-builder",
    "build:win": "cross-env ELECTRON=true nuxt generate && yarn electron:compile && electron-builder --win",
    "build:mac": "cross-env ELECTRON=true nuxt generate && yarn electron:compile && electron-builder --mac",
    "build:linux": "cross-env ELECTRON=true nuxt generate && yarn electron:compile && electron-builder --linux"
  },
  "dependencies": {
    "@ag-grid-community/locale": "^34.0.0",
    "@iconify-json/famicons": "^1.2.0",
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/heroicons-solid": "^1.2.1",
    "@nuxt/icon": "^1.3.1",
    "@nuxt/ui": "^2.17.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@sentry/nuxt": "^10.27.0",
    "@vueuse/components": "^10.11.0",
    "@vueuse/core": "^10.11.0",
    "@vueuse/nuxt": "^10.11.0",
    "ag-grid-enterprise": "^34.0.0",
    "ag-grid-vue3": "^34.0.0",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.12",
    "defu": "^6.1.4",
    "dexie": "^4.0.11",
    "dompurify": "^3.2.5",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "happy-dom": "^20.1.0",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.441.0",
    "mime": "^4.0.4",
    "monaco-editor": "^0.54.0",
    "nuxt": "^3.12.3",
    "nuxt-monaco-editor": "1.4.0",
    "nuxt-umami": "3.2.1",
    "p-queue": "^8.0.1",
    "puppeteer": "^24.40.0",
    "turndown": "^7.2.0",
    "uuid": "^11.0.3",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.22",
    "vue-shadow-dom": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/file-saver": "^2.0.7",
    "@types/turndown": "^5.0.5",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0",
    "node-machine-id": "^1.1.12",
    "prettier": "^3.5.2",
    "tailwindcss-debug-screens": "^2.2.1",
    "typescript": "^5.5.3",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
  "build": {
    "appId": "com.wemark.desktop",
    "productName": "WeMark",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/electron/**/*",
      ".output/public/**/*"
    ],
    "extraResources": [
      {
        "from": ".output/server",
        "to": "app/.output/server"
      },
      {
        "from": "public/favicon.ico",
        "to": "tray-icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "github",
      "owner": "fengafeng",
      "repo": "wemark-release"
    }
  }
}
